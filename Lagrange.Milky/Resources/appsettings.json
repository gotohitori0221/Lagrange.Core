{
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "Lagrange": {
        "Protocol": {
            // Protocol/Platform, available values:
            //   "Windows" | "MacOS" | "Linux"  -> PC protocol (uses "Signer" below)
            //   "AndroidPhone" | "AndroidPad" | "AndroidWatch" -> Android protocol (uses "AndroidSigner" below)
            "Platform": "Linux",
            // PC signer, only used when Platform is Windows / MacOS / Linux
            "Signer": {
                "BaseUrl": "https://sign.lagrangecore.org/api/",
                "Token": ""
                // "ProxyUrl": null // url, only http
            },
            // Android signer, only used when Platform is AndroidPhone / AndroidPad / AndroidWatch
            // Supports /sign/sec-sign, /sign/sec-sign/appinfo_v2
            "AndroidSigner": {
                "BaseUrl": "http://127.0.0.1:8081",
                "Token": ""
                // "ProxyUrl": null // url, only http
            }
        },
        "Login": {
            "Uin": 0 // Must be set
            // "Password": null // string, required for Android protocol
            // "AutoReLogin": true
            // "UseOnlineCaptchResolver": true
        }
        // "Server": {
        //     "AutoReconnect": true
        //     "UseIPv6Network": false
        //     "GetOptimumServer": true
        // }
        // "QrCode": {
        //     "Compatible": false
        // }
    },
    "Milky": {
        // "AccessToken": null, // string
        "HttpServer": {
            "Host": "127.0.0.1",
            "Port": 3000
        },
        "Api": {
            "Http": {
                "Enabled": true,
                // "AllowCorsOrigins": null // string, Access-Control-Allow-Origin
            }
        },
        "Event": {
            "WebSocket": {
                "Enabled": true
            }
            // "SSE": {
            //     "Enabled": true
            //     "AllowCorsOrigins": null, // string, Access-Control-Allow-Origin
            //     "HeartbeatIntervalSeconds": 60
            // },
            // "WebHook": {
            //     "Enabled": true
            //     "TargetUrls": [] // url array
            // }
        }
    }
}
